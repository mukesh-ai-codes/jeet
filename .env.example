# JEET Environment Configuration — Template
# Copy this to .env and fill in real values

# Database
DATABASE_URL=postgresql://USER@localhost:5432/jeet_dev
JEET_DB_HOST=localhost
JEET_DB_PORT=5432
JEET_DB_NAME=jeet_dev
JEET_DB_USER=
JEET_DB_PASSWORD=

# Simulation Parameters
JEET_SIM_STUDENTS=3000
JEET_SIM_DAYS=120
JEET_SIM_SEED=42
JEET_SIM_START_DATE=2026-01-01

# Logging
JEET_LOG_LEVEL=INFO